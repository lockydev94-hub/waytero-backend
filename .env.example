# ============================================================
# WAY TERO — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=WayTero
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-very-long-random-secret-key

# --- Database (PostgreSQL 17) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waytero_db
DB_USER=waytero_user
DB_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://waytero_user:change-this-password@localhost:5432/waytero_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-this-jwt-secret-key-must-be-very-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_VEHICLES=vehicles
MINIO_BUCKET_DRIVERS=drivers
MINIO_BUCKET_PARTNERS=partners
MINIO_BUCKET_HOTELS=hotels
MINIO_BUCKET_INVOICES=invoices

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- SMS (MSG91) ---
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=WAYTRO
MSG91_TEMPLATE_ID_OTP=your-template-id

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=WayTero
SMTP_FROM_EMAIL=noreply@waytero.com

# --- Payment (Razorpay) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- OTP Config ---
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
